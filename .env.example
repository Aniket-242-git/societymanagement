# =============================================================
# Society Management System — environment template
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# (On shared hosting / cPanel you can also set these as
#  Environment Variables in the Python App setup screen.)
# =============================================================

# ---- Django core -------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# Comma separated list, e.g. yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=*
# 1 = trust X-Forwarded-Proto (required behind cPanel/Apache/LiteSpeed proxy)
BEHIND_PROXY=0

# ---- Database ----------------------------------------------------
# ENV = dev  -> SQLite   (db.sqlite3, zero config — default for local dev)
# ENV = prod -> MySQL    (typical for shared "C plan" hosting)
ENV=dev

# Only used when ENV=prod (MySQL). Create the DB + user in cPanel first;
# cPanel prefixes them, e.g. myuser_society_db / myuser_admin
DB_NAME=society_db
DB_USER=society_admin
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Optional escape hatch: force a specific engine regardless of ENV
# (sqlite | mysql). Leave empty to follow ENV.
# DB_ENGINE=mysql

# ---- Pagination --------------------------------------------------
# Max records returned per page on every list endpoint
PAGE_SIZE=10

# ---- Uploads -----------------------------------------------------
MAX_UPLOAD_SIZE_MB=5

# ---- JWT ---------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---- Seed admin (used by `python manage.py seed_demo`) -----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin@123
SEED_ADMIN_EMAIL=admin@example.com

# ---- Site --------------------------------------------------------
SITE_NAME="Green Valley Society"
